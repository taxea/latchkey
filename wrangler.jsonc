{
  // Cloudflare Workers (static assets). Build with `npx astro build`, deploy with `npx wrangler deploy`.
  // In the Cloudflare dashboard: Compute > Workers & Pages > Create > Import a repository (taxea/latchkey)
  //   Build command:  npx astro build
  //   Deploy command: npx wrangler deploy
  // Then add the custom domain latchkeydaily.com under the Worker's Settings > Domains & Routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latchkeydaily",
  "compatibility_date": "2026-11-05",
  // Wrangler runs this before deploying, so `npx wrangler deploy` alone produces a full build.
  "build": {
    "command": "npx astro build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
