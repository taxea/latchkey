---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RelatedPages from '@/components/RelatedPages.astro';
import SignupForm from '@/components/SignupForm.astro';
import { definedTerm } from '@/lib/schema';
import { formatDate } from '@/lib/site';

export async function getStaticPaths() {
  const terms = await getCollection('glossary');
  return terms.map((t) => ({ params: { slug: t.id }, props: { term: t } }));
}
const { term } = Astro.props;
const { Content } = await render(term);
const d = term.data;
const url = `/glossary/${term.id}/`;
const seeAlso = (await Promise.all(d.seeAlso.map((id) => getEntry('glossary', id)))).filter(Boolean);
const title = `What is ${/^[A-Z]{2,}/.test(d.term) ? 'a ' + d.term : d.term.toLowerCase().match(/^[aeiou]/) ? 'an ' + d.term.toLowerCase() : 'a ' + d.term.toLowerCase()}?`;
const schema = [definedTerm({ url, term: d.term, definition: d.definition })];
---
<BaseLayout title={title} description={d.definition} crumbs={[{ name: 'Glossary', href: '/glossary/' }, { name: d.term, href: url }]} schema={schema} updated={d.updated}>
  <article class="container-site py-8 md:py-12">
    <header class="max-w-3xl">
      <p class="eyebrow mb-2">Glossary</p>
      <h1>{d.term}</h1>
      <p class="text-lg md:text-xl leading-relaxed mt-4"><strong>{d.term}</strong>: {d.definition}</p>
      <p class="text-sm text-muted mt-2">Updated {formatDate(d.updated)}</p>
    </header>
    <div class="prose-site">
      <Content />
      {d.example && <section><h2>An example</h2><p>{d.example}</p></section>}
      {d.whyItMatters && <section><h2>Why it matters to you</h2><p>{d.whyItMatters}</p></section>}
      {d.links.length > 0 && (
        <section>
          <h2>Where to go next</h2>
          <ul>{d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </section>
      )}
      <SignupForm source={`term-${term.id}`} heading="Plain English, every weekday" sub="The brief defines every new term the first time it appears." />
    </div>
    <RelatedPages title="See also" items={seeAlso.map((s) => ({ title: s!.data.term, href: `/glossary/${s!.id}/`, blurb: s!.data.definition }))} />
  </article>
</BaseLayout>
