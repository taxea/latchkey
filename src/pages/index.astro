---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SignupForm from '@/components/SignupForm.astro';
import TopicIcon from '@/components/TopicIcon.astro';
import { SITE, TOPICS, formatDate } from '@/lib/site';
import { person } from '@/lib/schema';

const issues = (await getCollection('issues')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestIssue = issues[0];
const alerts = (await getCollection('alerts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
const guides = (await getCollection('guides')).slice(0, 10);
const videos = (await getCollection('videos')).sort((a, b) => b.data.uploadDate.valueOf() - a.data.uploadDate.valueOf()).slice(0, 3);
const recs = (await getCollection('recommends')).filter((r) => r.data.kind === 'category').slice(0, 5);
const host = await getEntry('team', SITE.host.slug);
const subs = SITE.subscriberCount.toLocaleString('en-US');
const schema = host ? [person({ name: host.data.name, slug: host.id, role: host.data.role, bio: host.data.bio, knowsAbout: host.data.knowsAbout, sameAs: host.data.sameAs, image: host.data.image })] : [];
---
<BaseLayout title={SITE.name} description={SITE.description} schema={schema} hideCrumbs>
  <!-- 1. Hero with signup -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute right-0 top-0 h-full w-1/3 opacity-[0.07] stripes hidden md:block" aria-hidden="true"></div>
    <div class="container-site py-14 md:py-20 grid gap-10 md:grid-cols-5 items-center relative">
      <div class="md:col-span-3">
        <p class="tag mb-5"><span>Figured it out before. Still do.</span></p>
        <h1 class="uppercase text-5xl md:text-7xl leading-[0.92]">The Gen&nbsp;X guide to life in the middle.</h1>
        <p class="mt-6 text-lg md:text-xl max-w-2xl">{SITE.description}</p>
        <div class="mt-8 max-w-xl">
          <SignupForm variant="hero" source="hero" />
          <p class="text-sm text-muted mt-3">Join <strong class="text-ink">{subs}</strong> readers. <a href="/newsletter/sample/">Read a sample issue</a>.</p>
        </div>
      </div>
      <div class="md:col-span-2 hidden md:block" aria-hidden="true">
        <div class="relative aspect-square max-w-sm ml-auto">
          <div class="absolute inset-0 rounded-full bg-orange translate-x-10 -translate-y-6"></div>
          <div class="absolute bottom-0 left-0 right-0 h-1/2" style="clip-path: polygon(0 100%, 30% 35%, 48% 60%, 62% 20%, 100% 100%); background: var(--color-olive);"></div>
          <div class="absolute bottom-0 left-0 right-0 h-1/3" style="clip-path: polygon(0 100%, 20% 50%, 40% 80%, 70% 30%, 100% 100%); background: var(--color-ink);"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. What you get, in three -->
  <section class="container-site py-12">
    <p class="eyebrow mb-4">What you get, every weekday</p>
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card">
        <TopicIcon name="alert" class="w-9 h-9 text-orange mb-3" />
        <h2 class="mt-0 text-xl">Today's scams, and the fix</h2>
        <p class="text-muted">The text your mom got this week, decoded. What to do in one step, and how to make your family a hard target.</p>
        <a href="/scams/" class="font-display font-bold uppercase text-sm mt-3 inline-block">Scam database &rarr;</a>
      </div>
      <div class="card">
        <TopicIcon name="cursor" class="w-9 h-9 text-orange mb-3" />
        <h2 class="mt-0 text-xl">Tech made usable</h2>
        <p class="text-muted">What to actually use AI for, which gadgets are worth it, and what to ignore. In plain English, from the friend who works in IT.</p>
        <a href="/tech/" class="font-display font-bold uppercase text-sm mt-3 inline-block">Tech &rarr;</a>
      </div>
      <div class="card">
        <TopicIcon name="heart" class="w-9 h-9 text-orange mb-3" />
        <h2 class="mt-0 text-xl">The sandwich years</h2>
        <p class="text-muted">Aging parents, adult kids, retirement, taxes, estate plans. The money and family questions nobody prepared you for.</p>
        <a href="/family/" class="font-display font-bold uppercase text-sm mt-3 inline-block">Family &amp; money &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Topic strip (brand kit icon set) -->
  <section class="bg-cream border-y border-line">
    <div class="container-site py-6">
      <ul class="flex flex-wrap justify-between gap-4 list-none pl-0">
        {TOPICS.map((t) => (
          <li><a href={t.href} class="flex items-center gap-2 text-ink no-underline hover:text-orange-dark"><TopicIcon name={t.icon} class="w-6 h-6" /><span class="font-display font-bold text-sm">{t.label}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Today's issue -->
  {latestIssue && (
    <section class="container-site py-12">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <p class="eyebrow">Today's issue · {formatDate(latestIssue.data.date)}</p>
        <a href="/newsletter/archive/" class="text-sm font-semibold">All issues &rarr;</a>
      </div>
      <h2 class="mt-2"><a href={`/newsletter/issues/${latestIssue.id}/`} class="text-ink no-underline hover:underline">{latestIssue.data.title}</a></h2>
      <ol class="grid gap-3 md:grid-cols-3 list-none pl-0 mt-4">
        {latestIssue.data.items.map((it, i) => (
          <li class="border-l-4 border-orange pl-4">
            <span class="eyebrow">Item {i + 1}</span>
            <p class="font-semibold">{it.href ? <a href={it.href} class="text-ink">{it.headline}</a> : it.headline}</p>
          </li>
        ))}
      </ol>
      <p class="mt-5 bg-yellow/60 rounded-brand px-5 py-3 inline-block"><strong class="font-display uppercase mr-2">One action:</strong>{latestIssue.data.action}</p>
    </section>
  )}

  <!-- 4. The host -->
  {host && (
    <section class="bg-ink text-cream">
      <div class="container-site py-12 grid gap-8 md:grid-cols-3 items-center">
        <div class="md:col-span-2">
          <p class="eyebrow text-yellow mb-2">Who writes this</p>
          <h2 class="mt-0 text-cream">{host.data.name}</h2>
          <p class="text-cream/80 mt-2 text-lg">{host.data.bio}</p>
          <a href={`/about/team/${host.id}/`} class="btn btn-primary mt-5">About {host.data.name.split(' ')[0]}</a>
        </div>
        <div class="hidden md:block arcs h-48 rounded-brand opacity-70" aria-hidden="true"></div>
      </div>
    </section>
  )}

  <!-- 5. Latest scam alerts -->
  <section class="container-site py-12">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h2 class="mt-0">Latest scam alerts</h2>
      <a href="/tools/is-this-a-scam/" class="btn btn-outline text-sm py-2">Report a scam</a>
    </div>
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 list-none pl-0 mt-4">
      {alerts.map((a) => (
        <li class="card">
          <p class="eyebrow mb-1">{formatDate(a.data.date)} · {a.data.status}</p>
          <a href={`/scams/alerts/${a.id}/`} class="font-display font-bold text-lg leading-tight no-underline hover:underline">{a.data.title}</a>
          <p class="text-sm text-muted mt-1">{a.data.summary}</p>
        </li>
      ))}
    </ul>
    <p class="mt-4"><a href="/scams/" class="font-semibold">Browse every scam in the database &rarr;</a></p>
  </section>

  <!-- 6. Start here: the Deadbolt guides -->
  <section class="bg-cream border-y border-line">
    <div class="container-site py-12">
      <p class="eyebrow mb-2">Start here</p>
      <h2 class="mt-0">The 10-Minute Deadbolt</h2>
      <p class="text-muted max-w-2xl">Lock down one account a day. Each guide takes about ten minutes and ends with a version you can do for a parent.</p>
      <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-5 list-none pl-0 mt-5">
        {guides.map((g) => (
          <li class="bg-white border border-line rounded-brand p-3">
            <a href={`/protect/${g.id}/`} class="font-display font-bold text-ink no-underline hover:underline">{g.data.service}</a>
            <p class="text-xs text-muted mt-0.5">{g.data.atRisk}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4"><a href="/protect/" class="font-semibold">All lockdown guides &rarr;</a></p>
    </div>
  </section>

  <!-- 7. Watch -->
  {videos.length > 0 && (
    <section class="container-site py-12">
      <div class="flex items-baseline justify-between gap-4 flex-wrap">
        <h2 class="mt-0">Watch</h2>
        <a href="/watch/" class="text-sm font-semibold">All videos &rarr;</a>
      </div>
      <ul class="grid gap-4 md:grid-cols-3 list-none pl-0 mt-4">
        {videos.map((v) => (
          <li class="card p-0 overflow-hidden">
            <a href={`/watch/${v.id}/`} class="block no-underline">
              <img src={`https://i.ytimg.com/vi/${v.data.youtubeId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" class="w-full aspect-video object-cover" />
              <div class="p-4">
                <p class="eyebrow mb-1">{v.data.series.replace(/-/g, ' ')}</p>
                <span class="font-display font-bold text-lg leading-tight text-ink">{v.data.title}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- 8. Second signup -->
  <section class="container-site py-6">
    <div class="bg-orange text-white rounded-brand p-8 md:p-12 grid gap-6 md:grid-cols-2 items-center">
      <div>
        <h2 class="mt-0 text-white uppercase text-3xl md:text-4xl">Forward-worthy. Five minutes. Free.</h2>
        <p class="text-white/90 mt-2">One scam, one fix, one thing worth knowing. Send it to your brother.</p>
      </div>
      <form action={SITE.signupAction} method={SITE.signupMethod} class="flex flex-col sm:flex-row gap-2" data-signup="mid">
        <label for="signup-mid" class="sr-only">Email address</label>
        <input id="signup-mid" type="email" name="email" required placeholder="you@example.com" class="flex-1 rounded-brand px-4 py-3 text-ink bg-white border-2 border-white focus:outline-none focus:ring-2 focus:ring-yellow" />
        <input type="hidden" name="source" value="mid" />
        <button type="submit" class="btn btn-dark">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- 9. Latchkey Recommends -->
  {recs.length > 0 && (
    <section class="container-site py-12">
      <p class="eyebrow mb-2">Latchkey Recommends</p>
      <h2 class="mt-0">The tools we'd set up for our own parents</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5 list-none pl-0 mt-4">
        {recs.map((r) => (
          <li class="card"><a href={`/recommends/${r.data.category}/`} class="font-display font-bold no-underline hover:underline">{r.data.categoryTitle ?? r.data.title}</a><p class="text-xs text-muted mt-1">{r.data.forWhom}</p></li>
        ))}
      </ul>
      <p class="text-xs text-muted mt-3">Some links are affiliate links. We pick first and link second. <a href="/recommends/disclosure/">How that works.</a></p>
    </section>
  )}
</BaseLayout>
