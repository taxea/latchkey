---
import HubLayout from '@/layouts/HubLayout.astro';
const tools = [
  { title: 'Is this a scam?', href: '/tools/is-this-a-scam/', blurb: 'Paste the text or email. Get a verdict and the matching scam page, and warn other readers.', eyebrow: 'Live' },
  { title: 'Family Security Score', href: '/tools/family-security-score/', blurb: 'A three-minute quiz: how hard a target is your family, and the five things to fix first.', eyebrow: 'Coming soon' },
  { title: 'Password checkup', href: '/tools/password-checkup/', blurb: 'Are you reusing passwords across accounts that matter? A private, on-device check.', eyebrow: 'Coming soon' },
  { title: 'Breach check', href: '/tools/breach-check/', blurb: 'Find out which breaches included your email, and what to change.', eyebrow: 'Coming soon' },
];
---
<HubLayout
  title="Tools"
  eyebrow="Interactive"
  description="Free tools that answer one question each: is this a scam, how exposed is my family, am I reusing passwords, was my email in a breach. Private by design: nothing you paste is stored unless you choose to report it."
  crumbs={[{ name: 'Tools', href: '/tools/' }]}
  startHere={tools}
  signupSource="tools"
/>
