---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SignupForm from '@/components/SignupForm.astro';
import { collectionPage } from '@/lib/schema';
import { formatDate } from '@/lib/site';
const issues = (await getCollection('issues')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const months = [...new Set(issues.map((i) => i.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })))];
const description = 'Every issue of Latchkey Daily, in full, the day it sends. Browse by month.';
---
<BaseLayout title="Newsletter archive" description={description} crumbs={[{ name: 'Newsletter', href: '/newsletter/' }, { name: 'Archive', href: '/newsletter/archive/' }]} schema={[collectionPage({ url: '/newsletter/archive/', title: 'Newsletter archive', description, items: issues.map((i) => ({ name: i.data.title, href: `/newsletter/issues/${i.id}/` })) })]}>
  <div class="container-site py-8 md:py-12">
    <p class="eyebrow mb-2">{issues.length} issues</p>
    <h1 class="uppercase">Archive</h1>
    <p class="text-lg text-muted mt-3">{description}</p>
    <SignupForm source="archive" heading="Get tomorrow's issue" sub="Free, weekday mornings." />
    {months.map((m) => (
      <section class="mt-8">
        <h2 class="mt-0">{m}</h2>
        <ul class="divide-y divide-line border-y border-line list-none pl-0">
          {issues.filter((i) => i.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) === m).map((i) => (
            <li class="py-3 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
              <time class="text-xs font-display font-bold uppercase tracking-widest text-muted w-32 shrink-0" datetime={i.data.date.toISOString()}>{formatDate(i.data.date)}</time>
              <div><a href={`/newsletter/issues/${i.id}/`} class="font-semibold text-ink">{i.data.title}</a><p class="text-sm text-muted">{i.data.preview}</p></div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
