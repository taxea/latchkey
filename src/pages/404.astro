---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SignupForm from '@/components/SignupForm.astro';
import { HUBS } from '@/lib/site';
---
<BaseLayout title="Page not found" description="That page isn't here. Search the site or start from a section." noindex hideCrumbs>
  <div class="container-site py-14 md:py-24 max-w-2xl">
    <p class="tag mb-5"><span>404</span></p>
    <h1 class="uppercase">That page let itself out.</h1>
    <p class="text-lg mt-4 text-muted">It may have moved, or the link was wrong. Try a search or start from a section.</p>
    <form action="/search/" method="GET" class="flex gap-2 mt-6">
      <label for="q" class="sr-only">Search</label>
      <input id="q" name="q" type="search" placeholder="Search Latchkey Daily" class="flex-1 rounded-brand border-2 border-ink bg-white px-4 py-3" />
      <button class="btn btn-dark" type="submit">Search</button>
    </form>
    <ul class="flex flex-wrap gap-2 mt-6 list-none pl-0">
      {HUBS.map((h) => <li><a href={h.href} class="inline-block bg-cream rounded-full px-4 py-2 font-display font-bold no-underline text-ink hover:bg-yellow">{h.title}</a></li>)}
    </ul>
    <SignupForm source="404" heading="While you're here" sub="Five minutes, one action, every weekday." />
  </div>
</BaseLayout>
