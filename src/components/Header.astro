---
import Logo from './Logo.astro';
import { NAV, SECONDARY_NAV } from '@/lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="border-b border-line bg-paper/95 backdrop-blur sticky top-0 z-40">
  <div class="container-site">
    <div class="hidden md:flex items-center justify-end gap-5 text-xs uppercase tracking-widest font-display font-bold py-1.5 border-b border-line/60">
      {SECONDARY_NAV.map((item) => (
        <a href={item.href} class="text-muted hover:text-ink no-underline">{item.label}</a>
      ))}
    </div>
    <div class="flex items-center justify-between gap-4 py-3">
      <a href="/" class="no-underline shrink-0" aria-label="Latchkey Daily home">
        <Logo height={40} />
      </a>
      <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
        {NAV.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg font-display font-bold uppercase tracking-wide text-sm no-underline hover:bg-cream ${isActive(item.href) ? 'text-orange-dark' : 'text-ink'}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
            {'children' in item && item.children && (
              <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block bg-white border border-line rounded-brand shadow-lg min-w-40 p-2 z-50">
                {item.children.map((c) => (
                  <a href={c.href} class="block px-3 py-2 rounded-lg text-sm font-semibold text-ink no-underline hover:bg-cream">{c.label}</a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>
      <div class="flex items-center gap-2">
        <a href="/subscribe/" class="btn btn-primary text-sm py-2 px-4">Subscribe</a>
        <details class="lg:hidden relative">
          <summary class="list-none cursor-pointer p-2 rounded-lg hover:bg-cream" aria-label="Open menu">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </summary>
          <nav class="absolute right-0 top-full mt-2 w-64 bg-white border border-line rounded-brand shadow-xl p-3 z-50" aria-label="Mobile">
            {NAV.map((item) => (
              <div>
                <a href={item.href} class="block px-3 py-2 font-display font-bold uppercase tracking-wide text-sm text-ink no-underline hover:bg-cream rounded-lg">{item.label}</a>
                {'children' in item && item.children && item.children.slice(1).map((c) => (
                  <a href={c.href} class="block pl-6 pr-3 py-1.5 text-sm text-ink no-underline hover:bg-cream rounded-lg">{c.label}</a>
                ))}
              </div>
            ))}
            <hr class="my-2 border-line" />
            {SECONDARY_NAV.map((item) => (
              <a href={item.href} class="block px-3 py-1.5 text-sm text-muted no-underline hover:bg-cream rounded-lg">{item.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>
