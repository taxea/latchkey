---
/** Visible FAQ that matches the FAQPage schema exactly. Never invented questions. */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="my-10" id="faq">
    <h2>Questions people ask</h2>
    <dl class="divide-y divide-line border-y border-line">
      {items.map((f) => (
        <div class="py-4">
          <dt class="font-display font-bold text-lg">{f.q}</dt>
          <dd class="mt-1 text-muted">{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
