---
import Logo from './Logo.astro';
import SignupForm from './SignupForm.astro';
import { SITE, HUBS } from '@/lib/site';
const year = new Date().getFullYear();
const col2 = [
  { label: 'Membership', href: '/membership/' },
  { label: 'In Case', href: '/tools/in-case/' },
  { label: 'Serum', href: '/tools/serum/' },
  { label: 'All tools', href: '/tools/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Newsletter archive', href: '/newsletter/archive/' },
  { label: 'Do This Now', href: '/newsletter/do-this-now/' },
  { label: 'Watch', href: '/watch/' },
  { label: 'Press', href: '/about/press/' },
  { label: 'Advertise', href: '/about/advertise/' },
];
const col3 = [
  { label: 'About', href: '/about/' },
  { label: 'Team', href: '/about/team/' },
  { label: 'Editorial policy', href: '/about/editorial-policy/' },
  { label: 'How we use AI', href: '/about/how-we-use-ai/' },
  { label: 'Ownership', href: '/about/ownership/' },
  { label: 'Corrections', href: '/about/corrections/' },
  { label: 'Contact', href: '/about/contact/' },
];
---
<footer class="bg-ink text-cream mt-20">
  <div class="h-2 bg-orange"></div>
  <div class="container-site py-12 grid gap-10 md:grid-cols-4">
    <div>
      <p class="eyebrow text-yellow mb-3">Sections</p>
      <ul class="space-y-1.5">
        {HUBS.map((h) => <li><a href={h.href} class="text-cream no-underline hover:text-yellow">{h.title}</a></li>)}
        <li><a href="/recommends/" class="text-cream no-underline hover:text-yellow">Recommends</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow text-yellow mb-3">More</p>
      <ul class="space-y-1.5">
        {col2.map((l) => <li><a href={l.href} class="text-cream no-underline hover:text-yellow">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow text-yellow mb-3">Latchkey Daily</p>
      <ul class="space-y-1.5">
        {col3.map((l) => <li><a href={l.href} class="text-cream no-underline hover:text-yellow">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <Logo variant="inverse" height={40} />
      <p class="mt-3 text-cream/80 text-sm">{SITE.tagline}</p>
      <SignupForm variant="footer" source="footer" />
      <ul class="flex flex-wrap gap-3 mt-4 text-sm">
        <li><a href={SITE.social.youtube} class="text-cream no-underline hover:text-yellow" rel="me">YouTube</a></li>
        <li><a href={SITE.social.facebook} class="text-cream no-underline hover:text-yellow" rel="me">Facebook</a></li>
        <li><a href={SITE.social.instagram} class="text-cream no-underline hover:text-yellow" rel="me">Instagram</a></li>
        <li><a href={SITE.social.tiktok} class="text-cream no-underline hover:text-yellow" rel="me">TikTok</a></li>
        <li><a href={SITE.social.x} class="text-cream no-underline hover:text-yellow" rel="me">X</a></li>
        <li><a href="/feed.xml" class="text-cream no-underline hover:text-yellow">RSS</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream/15">
    <div class="container-site py-5 text-xs text-cream/70 flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
      <p>&copy; {year} {SITE.name}. <a href="/privacy/" class="text-cream/80 no-underline hover:text-yellow">Privacy</a> · <a href="/terms/" class="text-cream/80 no-underline hover:text-yellow">Terms</a> · <a href="/accessibility/" class="text-cream/80 no-underline hover:text-yellow">Accessibility</a></p>
      <p class="max-w-xl">{SITE.ownership}</p>
    </div>
  </div>
</footer>
