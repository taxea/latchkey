---
/** Line icons for the seven brand topics (laptop, family, heart, coins, dumbbell, cursor, mountain). */
interface Props { name: 'laptop' | 'family' | 'heart' | 'coins' | 'dumbbell' | 'cursor' | 'mountain' | 'shield' | 'key' | 'alert'; class?: string }
const { name, class: className = 'w-8 h-8' } = Astro.props;
const paths: Record<string, string> = {
  laptop: 'M3 6h18v10H3zM1 19h22',
  family: 'M8 7a3 3 0 100 6 3 3 0 000-6zM16 8a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM2 20c0-3 3-5 6-5s6 2 6 5M14 20c0-2.5 2-4 4.5-4S22 17.5 22 20',
  heart: 'M12 21s-8-5.5-8-11.5A4.5 4.5 0 0112 7a4.5 4.5 0 018 2.5C20 15.5 12 21 12 21zM12 10v5M9.5 12.5h5',
  coins: 'M12 7c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3zM4 4v5c0 1.7 3.6 3 8 3s8-1.3 8-3V4M4 9v5c0 1.7 3.6 3 8 3s8-1.3 8-3V9M4 14v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5',
  dumbbell: 'M2 10v4M5 8v8M19 8v8M22 10v4M5 12h14',
  cursor: 'M3 5h18v11H3zM8 21h8M12 16v5M14 9l3 1.5-1.5.5 1.5 2.5-1 .5-1.5-2.5-1 1.5z',
  mountain: 'M2 20l7-12 4 7 2-3 7 8zM9 8l1.5 2.5M16 4l2-2 2 2',
  shield: 'M12 3l8 3v6c0 4.5-3.5 8-8 9-4.5-1-8-4.5-8-9V6zM9 12l2 2 4-4',
  key: 'M14 4a6 6 0 100 12 6 6 0 000-12zM14 10h8M19 10v3M22 10v3',
  alert: 'M12 3l10 18H2zM12 10v4M12 17v1',
};
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true"><path d={paths[name] ?? paths.shield} /></svg>
