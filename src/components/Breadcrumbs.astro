---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-xs font-display font-bold uppercase tracking-widest text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-orange">/</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="text-ink">{it.name}</span>
          : <a href={it.href} class="text-muted no-underline hover:text-ink">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
