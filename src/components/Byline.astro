---
import { getEntry } from 'astro:content';
import { formatDate } from '@/lib/site';
interface Props {
  author?: string; // team slug
  published?: Date | string;
  updated?: Date | string;
  verified?: Date | string;
  reviewedBy?: string;
}
const { author = 'team', published, updated, verified, reviewedBy } = Astro.props;
const person = await getEntry('team', author);
const reviewer = reviewedBy && reviewedBy !== author ? await getEntry('team', reviewedBy) : null;
---
<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted my-4">
  {person && (
    <span>By <a href={`/about/team/${person.id}/`} class="font-semibold text-ink">{person.data.name}</a>{person.data.role && <span>, {person.data.role}</span>}</span>
  )}
  {reviewer && <span>Reviewed by <a href={`/about/team/${reviewer.id}/`} class="font-semibold text-ink">{reviewer.data.name}</a></span>}
  {published && <span>Published <time datetime={new Date(published).toISOString()}>{formatDate(published)}</time></span>}
  {updated && <span>Updated <time datetime={new Date(updated).toISOString()}>{formatDate(updated)}</time></span>}
  {verified && <span class="tag"><span>Verified {formatDate(verified)}</span></span>}
</div>
