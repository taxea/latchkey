---
/**
 * Base layout: head, schema, header, footer.
 * Every page passes title, description and (optionally) a JSON-LD graph plus breadcrumbs.
 */
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE, absolute } from '@/lib/site';
import { graph, organization, website, webpage, breadcrumbs as bc } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes for this page (Article, HowTo, FAQPage...). */
  schema?: (object | null | undefined)[];
  crumbs?: { name: string; href: string }[];
  noindex?: boolean;
  ogImage?: string;
  published?: Date | string;
  updated?: Date | string;
  type?: 'website' | 'article';
  /** Hide the visible breadcrumb row (home, landing pages). */
  hideCrumbs?: boolean;
}
const { title, description, schema = [], crumbs = [], noindex = false, ogImage = '/og-default.png', published, updated, type = 'website', hideCrumbs = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = absolute(path);
const fullTitle = path === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const allCrumbs = [{ name: 'Home', href: '/' }, ...crumbs];
const ld = graph(
  organization(),
  website(),
  webpage({ url: path, title, description, published, updated }),
  crumbs.length ? bc(allCrumbs) : null,
  ...schema,
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — all`} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@latchkeydaily" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(ogImage)} />
    {published && <meta property="article:published_time" content={new Date(published).toISOString()} />}
    {updated && <meta property="article:modified_time" content={new Date(updated).toISOString()} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-yellow px-3 py-2 rounded z-50">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      {!hideCrumbs && crumbs.length > 0 && (
        <div class="container-site pt-5">
          <Breadcrumbs items={allCrumbs} />
        </div>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
